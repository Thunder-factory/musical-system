{
  "rules": {
    ".read": false,
    ".write": false,
    "karaokeRooms": {
      ".indexOn": ["hostId"],
      "$roomCode": {
        ".read": "auth != null && (data.child('hostId').val() === auth.uid || data.child('participants').child(auth.uid).exists())",
        "state": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isString() && newData.val().matches(/^(waiting|playing|paused|ended)$/)"
        },
        "currentTime": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0"
        },
        "startedAt": {
          ".write": "auth != null && data.parent().child('hostId').val() === auth.uid",
          ".validate": "newData.isNumber()"
        },
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && !newData.exists()"
          }
        },
        "volumes": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && data.parent().parent().child('participants').child($uid).exists()",
            ".validate": "!newData.exists() || (newData.isNumber() && newData.val() >= 0 && newData.val() <= 1)"
          }
        }
      }
    }
  }
}
