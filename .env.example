# ============================================================
# 13. FRONTEND WEB
# ============================================================

FRONTEND_PORT=5173
FRONTEND_INTERNAL_PORT=5173

CHOKIDAR_USEPOLLING=true


# ============================================================
# 14. DOMINIOS Y URLS PUBLICAS
# ============================================================

APP_DOMAIN=musicgen.duckdns.org

FRONTEND_PUBLIC_URL=https://musicgen.duckdns.org


# ============================================================
# 15. CADDY
# ============================================================

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_HTTPS_UDP_PORT=443


# ============================================================
# 16. CONTENEDORES - DESARROLLO
# ============================================================

DEV_POSTGRES_CONTAINER=musical_postgres_dev
DEV_BACKEND_CONTAINER=musical_backend_dev
DEV_FRONTEND_CONTAINER=musical_frontend_dev
DEV_REDIS_CONTAINER=musical_redis_dev
DEV_CELERY_WORKER_CONTAINER=musical_celery_dev

DEV_CELERY_BEAT_CONTAINER=musical_celery_beat_dev


# ============================================================
# 17. CONTENEDORES - PRODUCCION
# ============================================================

PROD_POSTGRES_CONTAINER=musical_postgres_prod
PROD_BACKEND_CONTAINER=musical_backend_prod
PROD_FRONTEND_CONTAINER=musical_frontend_prod
PROD_REDIS_CONTAINER=musical_redis_prod
PROD_CELERY_CONTAINER=musical_celery_prod
PROD_CADDY_CONTAINER=musical_caddy_prod


# ============================================================
# 18. VOLUMENES - DESARROLLO
# ============================================================

DEV_POSTGRES_VOLUME=musical_pgdata_dev
DEV_REDIS_VOLUME=musical_redisdata_dev
DEV_FRONTEND_NODE_MODULES_VOLUME=musical_frontend_node_modules_dev


# ============================================================
# 19. VOLUMENES - PRODUCCION
# ============================================================

PROD_POSTGRES_VOLUME=musical_pgdata_prod
PROD_REDIS_VOLUME=musical_redisdata_prod

PROD_CADDY_DATA_VOLUME=musical_caddy_data_prod
PROD_CADDY_CONFIG_VOLUME=musical_caddy_config_prod

PROD_STATIC_VOLUME=musical_static_prod
PROD_MEDIA_VOLUME=musical_media_prod


# ============================================================
# 20. REDES DOCKER
# ============================================================

DEV_NETWORK=musical-dev
PROD_NETWORK=musical-prod