# ============================================================
# MUSICAL SYSTEM - VARIABLES GLOBALES
# ============================================================
# Configuracion centralizada de Docker Compose y aplicaciones
# ============================================================


# ============================================================
# 1. PROYECTOS DOCKER COMPOSE
# ============================================================

DEV_PROJECT_NAME=musical-system-dev
BUILD_PROJECT_NAME=musical-system-build
PROD_PROJECT_NAME=musical-system-prod


# ============================================================
# 2. IMAGENES DOCKER
# ============================================================

POSTGRES_IMAGE=postgres:16-alpine
PYTHON_IMAGE=python:3.12-slim
NODE_IMAGE=node:22-bookworm-slim
REDIS_IMAGE=redis:7-alpine
CADDY_IMAGE=caddy:2-alpine

BACKEND_IMAGE=DOCKER-USER/musical-system-backend:v1.0.0
FRONTEND_IMAGE=DOCKER-USER/musical-system-frontend:v1.0.0


# ============================================================
# 3. POSTGRESQL
# ============================================================

DATABASE_HOST=postgres
DATABASE_PORT=56432
DATABASE_INTERNAL_PORT=5432

DATABASE_NAME=musical_dev
DATABASE_USER=musical_dev_user
DATABASE_PASSWORD=change-this-dev-database-password
DATABASE_SSLMODE=disable


# ============================================================
# 4. DJANGO - CONFIGURACION GENERAL
# ============================================================

DJANGO_SECRET_KEY=change-this-long-random-dev-django-secret-key
DEV_DEBUG=True
DEV_ALLOWED_HOSTS=localhost,127.0.0.1,backend

BACKEND_HOST=0.0.0.0
BACKEND_INTERNAL_PORT=8000
BACKEND_HOST_PORT=8000

# Produccion
PROD_DEBUG=False
PROD_ALLOWED_HOSTS=musicgen.duckdns.org,backend

# Credenciales del superadmin creado por el seed
SUPERADMIN_USERNAME=admin@musicalsystem.com
SUPERADMIN_PASSWORD=admin12345

# Configuracion general de Python
TZ=America/La_Paz
DJANGO_TIME_ZONE=America/La_Paz

PYTHONUNBUFFERED=1
PYTHONDONTWRITEBYTECODE=1

# CLOUDFLARE R2 - CONEXIÓN
R2_ACCOUNT_ID=...
R2_ENDPOINT=...
R2_REGION=auto
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...

R2_DOCUMENTS_BUCKET=musical-bucket


# ============================================================
# 5. DJANGO - CORS
# ============================================================

DEV_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

PROD_CORS_ALLOWED_ORIGINS=https://musicgen.duckdns.org

CORS_ALLOW_CREDENTIALS=True


# ============================================================
# 6. REDIS Y CELERY
# ============================================================

REDIS_URL=redis://redis:6379/0
CELERY_TASK_ALWAYS_EAGER=False


# ============================================================
# 7. AWS S3 - ALMACENAMIENTO DE AUDIO
# ============================================================


# ============================================================
# 8. MODAL - GENERACION MUSICAL CON IA
# ============================================================

MODAL_ENDPOINT_FROM_DESCRIPTION=
MODAL_ENDPOINT_WITH_LYRICS=
MODAL_ENDPOINT_FROM_DESCRIBED_LYRICS=
MODAL_ENDPOINT_SEPARATE_STEMS=
# Tarareo -> "Mejorar con IA" (ACE-Step audio2audio, función generate_from_reference)
MODAL_ENDPOINT_FROM_REFERENCE=
# Precalentar la GPU de la IA al subir un tarareo (función warm_cover)
MODAL_ENDPOINT_WARM_COVER=

MODAL_KEY=
MODAL_SECRET=

MODAL_CONNECT_TIMEOUT_SECONDS=10
MODAL_GENERATION_READ_TIMEOUT_SECONDS=900
MODAL_SUBMIT_READ_TIMEOUT_SECONDS=30
MODAL_STATUS_READ_TIMEOUT_SECONDS=30
MODAL_REQUEST_RETRIES=3
STEM_MAX_DURATION_SECONDS=900
STEM_REMOTE_TIMEOUT_SECONDS=1800
GENERATION_PROCESSING_STALE_SECONDS=1800
KARAOKE_PROCESSING_STALE_SECONDS=1800
MIX_EXPORT_PROCESSING_STALE_SECONDS=1800
STEM_POLL_INTERVAL_SECONDS=5
DEMUCS_GPU=T4
DEMUCS_JOB_TTL_SECONDS=3600
DEMUCS_SPAWN_LEASE_SECONDS=300


# ============================================================
# 9. INTELIGENCIA ARTIFICIAL
# ============================================================

# ============================================
# AI- opcional
# ============================================
# Clave de API para servicios de OpenAI
OPENAI_API_KEY=

# Clave de API para procesamiento de letras con Gemini
GEMINI_API_KEY=

# ============================================
# GROQ - CONFIGURACIÓN GENERAL
# ============================================
GROQ_API_KEYS=tu_api_key_actual
GROQ_BASE_URL=https://api.groq.com/openai/v1

# TRANSCRIPCIÓN DE CANCIONES
GROQ_MODEL=whisper-large-v3
GROQ_LANGUAGE=auto

# TRADUCCIÓN Y ADAPTACIÓN MUSICAL
GROQ_LYRICS_MODEL=openai/gpt-oss-120b
GROQ_LYRICS_TIMEOUT_SECONDS=120

# LÍMITES DE PROCESAMIENTO
AI_AUDIO_MAX_MB=20
AI_TRANSCRIPTION_TIMEOUT_SECONDS=60


# ============================================================
# 10. AUDIO Y KARAOKE
# ============================================================

FFMPEG_PATH=ffmpeg


# ============================================================
# 11. STRIPE - PAGOS Y CREDITOS
