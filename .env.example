# ============================================================
# 13. FRONTEND WEB
# ============================================================

FRONTEND_PORT=5173
FRONTEND_INTERNAL_PORT=5173

CHOKIDAR_USEPOLLING=true


# ============================================================
# 14. DOMINIOS Y URLS PUBLICAS
# ============================================================

APP_DOMAIN=musicgen.duckdns.org

FRONTEND_PUBLIC_URL=https://musicgen.duckdns.org


# ============================================================
# 15. CADDY
# ============================================================

CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
CADDY_HTTPS_UDP_PORT=443


# ============================================================
# 9b. TARAREO - WORKER gm_tarareo
# ============================================================
# Secreto compartido worker <-> Django (header X-Worker-Token).
# Generar uno largo y aleatorio, por ejemplo:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TARAREO_CALLBACK_TOKEN=
TARAREO_URL=http://tarareo:8000
TARAREO_CALLBACK_URL=http://backend:8000/api/humming/callback/
TARAREO_CAPACIDAD=2
HUMMING_CREDIT_COST=1
HUMMING_MAX_UPLOAD_MB=25
HUMMING_POLL_INTERVAL_SECONDS=30
HUMMING_PROCESSING_STALE_SECONDS=1200
HUMMING_QUEUE_STALE_SECONDS=1800
HUMMING_MAX_DISPATCH_ATTEMPTS=3
HUMMING_ENHANCE_CREDIT_COST=1
HUMMING_ENHANCE_VARIANTS=3
HUMMING_AI_VERSIONS=True
HUMMING_ENHANCE_POLL_INTERVAL_SECONDS=3
# % de parecido de cada versión con IA (lo mide el worker de tarareo en CPU)
HUMMING_SIMILARITY=True
HUMMING_SIMILARITY_TIMEOUT_SECONDS=120
HUMMING_ENHANCE_STALE_SECONDS=1800


# ============================================================
# 16. CONTENEDORES - DESARROLLO
# ============================================================

DEV_POSTGRES_CONTAINER=musical_postgres_dev
DEV_BACKEND_CONTAINER=musical_backend_dev
DEV_FRONTEND_CONTAINER=musical_frontend_dev
DEV_REDIS_CONTAINER=musical_redis_dev
DEV_CELERY_WORKER_CONTAINER=musical_celery_dev

DEV_CELERY_BEAT_CONTAINER=musical_celery_beat_dev
DEV_TARAREO_CONTAINER=musical_tarareo_dev
DEV_CELERY_HUMMING_CONTAINER=musical_celery_humming_dev


