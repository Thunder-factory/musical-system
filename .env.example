# Copiar a .env y ajustar si hace falta. Todos los valores tienen default
# razonable en app/config.py — este archivo solo documenta qué existe.

TARAREO_VERSION=0.1.0
TARAREO_NIVEL_LOG=INFO

# Solo para desarrollo local: acepta rutas locales y file:// en inputUrls.
# En producción (Docker junto a Django) dejarlo en false: solo URLs http(s)
# prefirmadas de R2. El default en app/config.py es false.
TARAREO_MODO_DESARROLLO=true

# Jobs simultáneos; si llega uno más, /procesar responde 503 + Retry-After.
TARAREO_CAPACIDAD=2

TARAREO_DESCARGA_TAMANO_MAXIMO_MB=25.0
TARAREO_DESCARGA_TIMEOUT_SEGUNDOS=30.0

TARAREO_DIRECTORIO_SALIDAS=salidas

TARAREO_FRECUENCIA_MUESTREO_HZ=22050

TARAREO_DURACION_MINIMA_SEGUNDOS=8.0
TARAREO_DURACION_MAXIMA_SEGUNDOS=30.0

TARAREO_UMBRAL_SILENCIO_DBFS=-45.0

TARAREO_MELODIA_CONFIANZA_MINIMA=0.42

TARAREO_LIMPIEZA_SEMITONOS_OCTAVA=12
TARAREO_LIMPIEZA_HUECO_FUSION_MS=50.0
TARAREO_LIMPIEZA_MARGEN_OCTAVAS_MEDIANA=1.0
TARAREO_LIMPIEZA_AMPLITUD_MINIMA=0.40
TARAREO_LIMPIEZA_DURACION_MINIMA_MS=80.0

TARAREO_CALLBACK_TIMEOUT_SEGUNDOS=5.0

# --- Render (etapa 8) ---
# Vacíos = se buscan en herramientas/ (desarrollo local) y FluidSynth en el PATH.
# En Docker: TARAREO_FLUIDSYNTH=fluidsynth y
#            TARAREO_SOUNDFONT=/usr/share/sounds/sf2/FluidR3_GM.sf2 (paquete fluid-soundfont-gm)
# TARAREO_FLUIDSYNTH=
# TARAREO_SOUNDFONT=
TARAREO_RENDER_LUFS_OBJETIVO=-16.0
TARAREO_RENDER_PICO_MAXIMO_DBTP=-1.0
TARAREO_RENDER_BITRATE_KBPS=192
# EQ y compresión suaves + reverb moderada. false = sonido anterior, mismo volumen.
TARAREO_RENDER_MASTERIZACION=true
TARAREO_MELODIA_EXPRESIVA=true
# Interpretación acústica y ritmo fiel. Oscilación expresiva al 40 %.
TARAREO_INTERPRETACION_VERIFICAR_ALTURAS=true
TARAREO_ANALISIS_RITMO_FIEL=true
TARAREO_EXPRESION_INTENSIDAD=0.4
# Muestras de estilos: solo se renderizan 16 s hasta pedir la versión completa.
TARAREO_MUESTRA_SEGUNDOS=16
TARAREO_ARREGLO_CON_ESTRIBILLO=true
TARAREO_ARREGLO_VARIEDAD_RITMICA=true
# Clima musical por reglas y capas de instrumentos por sección (sin GPU).
TARAREO_ARREGLO_CLIMA_MUSICAL=true
TARAREO_ARREGLO_INSTRUMENTACION_AMPLIADA=true

# --- Integración con Django y R2 (bloque 2) ---
# Secreto compartido con Django: va en el header X-Worker-Token de cada callback.
# TARAREO_CALLBACK_TOKEN=
TARAREO_CALLBACK_REINTENTOS=3
TARAREO_SUBIDA_TIMEOUT_SEGUNDOS=60.0
TARAREO_SUBIDA_REINTENTOS=3

# --- Retención (cuánto guarda el worker) ---
TARAREO_RETENCION_JOBS_MINUTOS=60
TARAREO_MAXIMO_JOBS_EN_MEMORIA=1000
TARAREO_RETENCION_SALIDAS_HORAS=24
