# Backend Django para la VM de Azure (CPU, sin GPU).
# Igual que gm_backend/Dockerfile.dev, pero instala torch para CPU antes de requirements:
# openai-whisper (karaoke) arrastraría torch con CUDA, varios GB que la VM no usa.
ARG PYTHON_IMAGE=python:3.12-slim
FROM ${PYTHON_IMAGE}

ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 PIP_NO_CACHE_DIR=1 PIP_DISABLE_PIP_VERSION_CHECK=1

RUN apt-get update && apt-get install -y --no-install-recommends build-essential git ffmpeg libsndfile1 \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

RUN python -m pip install --upgrade pip \
    && python -m pip install torch --index-url https://download.pytorch.org/whl/cpu

COPY requirements.txt .
# requirements.txt fija synchronicity, que choca con la versión que pide modal: se deja que pip elija.
RUN grep -v '^synchronicity==' requirements.txt > /tmp/req.txt && python -m pip install -r /tmp/req.txt

COPY . .
EXPOSE 8000
CMD ["python", "manage.py", "runserver", "0.0.0.0:8000"]
